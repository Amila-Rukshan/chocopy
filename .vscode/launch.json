    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug ChocoPy",
            "preLaunchTask": "Build (Debug)",
            "program": "${workspaceFolder}/build/chocopyc",
            "args": ["${workspaceFolder}/testprograms/choco.py"],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Lexer Tests",
            "preLaunchTask":  "Build Lexer Test (Debug)",
            "program": "${workspaceFolder}/build/tests/Lexer/LexerTest",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Parser Tests",
            "preLaunchTask":  "Build Parser Test (Debug)",
            "program": "${workspaceFolder}/build/tests/Parser/ParserTest",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Semantic Check Tests",
            "preLaunchTask":  "Build SemanticCheck Test (Debug)",
            "program": "${workspaceFolder}/build/tests/SemanticCheck/SemanticCheckTest",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Code Gen Tests",
            "preLaunchTask":  "Build CodeGen Test (Debug)",
            "program": "${workspaceFolder}/build/tests/CodeGen/CodeGenTest",
            "cwd": "${workspaceFolder}"
        },
    ]
}
